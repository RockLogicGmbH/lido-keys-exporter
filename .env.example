# Copy to .env and adjust. All values are optional; config.yaml is used when unset.

# Comma separated endpoint lists, tried in order (override config.yaml).
LKE_EXECUTION_ENDPOINTS=http://execution-1:8545,http://execution-2:8545
LKE_BEACON_ENDPOINTS=http://beacon-1:5052,http://beacon-2:5052
LKE_LOG_LEVEL=INFO

# Image to run, e.g. ghcr.io/<owner>/lido-keys-exporter (built locally when unset).
LKE_IMAGE=lido-keys-exporter
# Image tag.
LKE_IMAGE_TAG=latest

# Host ports.
LKE_PORT=9800
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Grafana admin login.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# Grafana alert thresholds for open exit requests (hours since the request).
LKE_EXIT_WARN_HOURS=48
LKE_EXIT_CRIT_HOURS=84
